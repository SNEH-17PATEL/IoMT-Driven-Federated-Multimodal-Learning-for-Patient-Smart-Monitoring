# =============================================================
# SENSITIVE — never push these
# =============================================================
.env
.env.local
.env.*.local

# =============================================================
# DATA — too large for GitHub (191–197 MB each, limit = 100 MB)
# Also derived from MIMIC-III (data use agreement applies)
# =============================================================
data/fl_training/*.csv

# =============================================================
# LEGACY CSV FILES — app now reads/writes the SQLite DB only.
# =============================================================
models/patient_vitals/*.csv
models/prediction_history/*.csv

# =============================================================
# SQLITE DATABASE — runtime state + MIMIC-III derived data
# Generated by:  python migrate_to_db.py
# Size:          ~23 MB — too large and contains MIMIC-III data
# Recreate with: python migrate_to_db.py
# =============================================================
models/icu_monitor.db
models/icu_monitor.db-shm
models/icu_monitor.db-wal

# =============================================================
# MODEL ARTIFACTS — large binaries; keep only the canonical one
# =============================================================
# federated_model_best.pth: intermediate checkpoint, not needed
models/federated_model_best.pth
# face_landmarker.task: auto-downloaded by cv_monitor.py (~12 MB)
face_landmarker.task

# Keep directory placeholders so folders exist after a fresh clone
!models/patient_vitals/.gitkeep
!models/prediction_history/.gitkeep

# =============================================================
# PYTHON CACHE
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
build/
*.egg
.pytest_cache/

# =============================================================
# FRONTEND BUILD OUTPUT
# =============================================================
frontend/dist/
frontend/node_modules/
frontend/.oxlintrc.json

# =============================================================
# macOS
# =============================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# =============================================================
# VIRTUAL ENVIRONMENTS
# =============================================================
venv/
.venv/
env/
ENV/

# =============================================================
# IDE
# =============================================================
.vscode/settings.json
.idea/
*.swp
*.swo

# =============================================================
# JUPYTER
# =============================================================
.ipynb_checkpoints/
