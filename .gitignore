# =============================================================
# SENSITIVE — NEVER push these
# =============================================================
.env
.env.local
.env.*.local

# Streamlit secrets (may contain API keys, database URLs, etc.)
# .streamlit/config.toml is intentionally tracked (theme + server settings)
.streamlit/secrets.toml

# =============================================================
# DATA — MIMIC-III derived / too large for GitHub (100 MB limit)
# Source: Google BigQuery mimic-project-2.Dataset.ml_dataset_final
# Recreate: python migrate_to_db.py  (reads from SQLite after first run)
# =============================================================
data/fl_training/*.csv

# =============================================================
# LEGACY CSV BACKUPS — app now reads/writes SQLite only
# These are the original CSVs that migrate_to_db.py imported from.
# Gitignored because the canonical data lives in models/icu_monitor.db.
# =============================================================
models/patient_vitals/*.csv
models/prediction_history/*.csv

# =============================================================
# SQLITE DATABASE — runtime state + MIMIC-III derived data
# Size: ~23 MB — too large; also subject to MIMIC-III data use agreement
# Recreate: python migrate_to_db.py
# =============================================================
models/icu_monitor.db
models/icu_monitor.db-shm
models/icu_monitor.db-wal

# =============================================================
# MODEL ARTIFACTS — large or intermediate; not needed in the repo
# Tracked artifacts (DO commit): federated_model.pth, scaler.pkl,
#   tfidf_vectorizer.pkl, feature_columns.pkl, shap_background.npy,
#   training_metadata.json
# =============================================================
# Intermediate checkpoint saved during training; federated_model.pth is canon
models/federated_model_best.pth
# Auto-downloaded by cv_monitor.py on first run (~12 MB MediaPipe model)
face_landmarker.task

# Keep directory placeholders so the folders exist on a fresh clone
!models/patient_vitals/.gitkeep
!models/prediction_history/.gitkeep

# =============================================================
# PYTHON CACHE
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
build/
dist/
*.egg
.pytest_cache/

# =============================================================
# TEST & COVERAGE REPORTS
# Generated by: pytest --cov  /  npx playwright test
# =============================================================
.coverage
coverage.xml
htmlcov/
test-results/
playwright-report/
playwright/.cache/

# =============================================================
# FRONTEND BUILD OUTPUT & DEPENDENCIES
# =============================================================
frontend/dist/
frontend/node_modules/
# Symlink created by: ln -sf frontend/node_modules node_modules
# Allows Vitest/Vite to resolve packages when running tests from icu_monitor/
node_modules/

# Auto-generated Vite template file; project uses custom oxlint config
frontend/.oxlintrc.json

# =============================================================
# LOGS
# =============================================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================================
# macOS
# =============================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# =============================================================
# VIRTUAL ENVIRONMENTS
# =============================================================
venv/
.venv/
env/
ENV/

# =============================================================
# IDE & EDITORS
# =============================================================
.vscode/settings.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# =============================================================
# JUPYTER
# =============================================================
.ipynb_checkpoints/
