# =============================================================
# SENSITIVE — never push these
# =============================================================
.env
.env.local

# =============================================================
# DATA — too large for GitHub (191–197 MB each, limit = 100 MB)
# Also derived from MIMIC-III (data use agreement applies)
# =============================================================
data/fl_training/*.csv

# =============================================================
# LEGACY BACKUP FILES — app now reads/writes the SQLite DB only.
# These CSV files may exist from a previous version; keep them gitignored.
# =============================================================
models/patient_vitals/*.csv
models/prediction_history/*.csv
# server.py creates this during real FL demo; not needed in git
# (federated_model.pth is the canonical artifact — commit that one)
models/federated_model_best.pth

# Keep directory placeholders so folders exist after a fresh clone
!models/patient_vitals/.gitkeep
!models/prediction_history/.gitkeep

# =============================================================
# SQLITE DATABASE — runtime state + MIMIC-III derived data
# Generated by:  python migrate_to_db.py
# Size:          ~53 MB — too large and contains MIMIC-III data
#                (data use agreement applies to fl_training table)
# Recreate with: python migrate_to_db.py  (from existing CSV files)
#             or: python train_federated.py  (full retrain from BigQuery)
# =============================================================
models/icu_monitor.db

# =============================================================
# COMPUTER VISION MODEL — auto-downloaded on first run (~12 MB)
# Downloaded by cv_monitor.py from Google MediaPipe CDN.
# Too large for git and regenerated automatically — not tracked.
# =============================================================
face_landmarker.task

# =============================================================
# PYTHON CACHE
# =============================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# =============================================================
# macOS
# =============================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# =============================================================
# VIRTUAL ENVIRONMENTS
# =============================================================
venv/
.venv/
env/
ENV/

# =============================================================
